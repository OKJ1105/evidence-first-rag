{
  "//": "Checks the agent loop runs between a Writer turn and the Reviewer that follows. The loop reads this file from the BASE branch (BF4), so a branch cannot weaken the checks it is judged against; a pull request that adds checks gets them in the loop only after it merges. Commands run in the branch checkout with a credential-stripped environment; {baseRef} is replaced with the pull request's base ref. CI stays authoritative for merge. {baseDir} is replaced with the base checkout's path: a check implemented as a repository script names it that way so base's code runs against head's files. Checks that must run the branch's own code (the agent unit tests) deliberately do not.",
  "checks": [
    {
      "name": "whitespace",
      "command": [
        "git",
        "diff",
        "--check",
        "origin/{baseRef}...HEAD"
      ]
    },
    {
      "name": "markdown-links",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/validate_links.py"
      ]
    },
    {
      "name": "fixtures",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/validate_fixtures.py"
      ]
    },
    {
      "name": "fixture-check-unit-tests",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/test_validate_fixtures.py"
      ]
    },
    {
      "name": "sensitive-strings",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/scan_sensitive_strings.py"
      ]
    },
    {
      "name": "sensitive-string-scan-unit-tests",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/test_scan_sensitive_strings.py"
      ]
    },
    {
      "name": "sensitive-strings-history",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/scan_history_sensitive_strings.py"
      ]
    },
    {
      "name": "sensitive-string-history-scan-unit-tests",
      "command": [
        "python3",
        "{baseDir}/scripts/checks/test_scan_history_sensitive_strings.py"
      ]
    },
    {
      "name": "package-unit-tests",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "--start-directory",
        "tests",
        "--top-level-directory",
        "."
      ]
    },
    {
      "name": "agent-unit-tests",
      "command": [
        "node",
        "--test",
        "scripts/agent/*.test.mjs",
        "ui/*.test.mjs"
      ]
    }
  ]
}
